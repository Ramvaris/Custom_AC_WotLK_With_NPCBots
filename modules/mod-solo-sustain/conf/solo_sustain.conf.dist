[worldserver]

########################################
# Solo Sustain Module Configuration
# Author: Ramvaris
# 
# Passive life and mana leech based on player damage dealt.
# Player heals themselves AND their pets/guardians from their own damage.
# 
# Design: Player deals damage → Player heals → Pet/Guardian also heals
# Pets/Guardians do NOT trigger leech from their own damage.
########################################

# Enable/Disable the module
SoloSustain.Enable = 1

########################################
# SPELL IDs
# Combat log name/icon comes from the spell's DBC entry.
# 
# Default: Standard WoW spells (exist in default Spell.dbc)
#   15286 = Vampiric Embrace (heal visual in combat log)
#   57669 = Replenishment (mana visual in combat log)
########################################

SoloSustain.SpellId.Heal = 15286
SoloSustain.SpellId.Mana = 57669

########################################
# PET/GUARDIAN SUSTAIN
# When enabled, player's damage heals their active minions too.
# Health: Always healed
# Mana: Only if the pet/guardian uses mana
########################################

# Heal player's permanent pet (Hunter/Warlock pets)
SoloSustain.Pet.Enable = 1

# Heal player's guardians (Army of Dead, Mirror Images, etc.)
SoloSustain.Guardian.Enable = 1

########################################
# LIFE LEECH PER CLASS
# Percentage of damage dealt that heals the player (and minions).
# 0.10 = 10% of damage dealt becomes health.
########################################

SoloSustain.LifeLeech.Warrior = 0.10
SoloSustain.LifeLeech.Paladin = 0.10
SoloSustain.LifeLeech.Hunter = 0.10
SoloSustain.LifeLeech.Rogue = 0.10
SoloSustain.LifeLeech.Priest = 0.10
SoloSustain.LifeLeech.DeathKnight = 0.10
SoloSustain.LifeLeech.Shaman = 0.10
SoloSustain.LifeLeech.Mage = 0.10
SoloSustain.LifeLeech.Warlock = 0.10
SoloSustain.LifeLeech.Druid = 0.10

########################################
# MANA LEECH PER CLASS
# Percentage of damage dealt that restores mana.
# 0.10 = 10% of damage dealt becomes mana.
# Set to 0 for non-mana classes (Warrior, Rogue, DK).
########################################

SoloSustain.ManaLeech.Warrior = 0.00
SoloSustain.ManaLeech.Paladin = 0.10
SoloSustain.ManaLeech.Hunter = 0.10
SoloSustain.ManaLeech.Rogue = 0.00
SoloSustain.ManaLeech.Priest = 0.10
SoloSustain.ManaLeech.DeathKnight = 0.00
SoloSustain.ManaLeech.Shaman = 0.10
SoloSustain.ManaLeech.Mage = 0.10
SoloSustain.ManaLeech.Warlock = 0.10
SoloSustain.ManaLeech.Druid = 0.10

########################################
# PET HEALTH MULTIPLIER PER CLASS
# Scales the HEALTH heal amount that pets receive.
# 1.0 = same as player, 0.5 = half, 2.0 = double
########################################

SoloSustain.Pet.Health.Multiplier.Warrior = 1.0
SoloSustain.Pet.Health.Multiplier.Paladin = 1.0
SoloSustain.Pet.Health.Multiplier.Hunter = 1.0
SoloSustain.Pet.Health.Multiplier.Rogue = 1.0
SoloSustain.Pet.Health.Multiplier.Priest = 1.0
SoloSustain.Pet.Health.Multiplier.DeathKnight = 1.0
SoloSustain.Pet.Health.Multiplier.Shaman = 1.0
SoloSustain.Pet.Health.Multiplier.Mage = 1.0
SoloSustain.Pet.Health.Multiplier.Warlock = 1.0
SoloSustain.Pet.Health.Multiplier.Druid = 1.0

########################################
# PET MANA MULTIPLIER PER CLASS
# Scales the MANA restore amount that pets receive.
# 1.0 = same as player, 0.5 = half, 2.0 = double
########################################

SoloSustain.Pet.Mana.Multiplier.Warrior = 1.0
SoloSustain.Pet.Mana.Multiplier.Paladin = 1.0
SoloSustain.Pet.Mana.Multiplier.Hunter = 1.0
SoloSustain.Pet.Mana.Multiplier.Rogue = 1.0
SoloSustain.Pet.Mana.Multiplier.Priest = 1.0
SoloSustain.Pet.Mana.Multiplier.DeathKnight = 1.0
SoloSustain.Pet.Mana.Multiplier.Shaman = 1.0
SoloSustain.Pet.Mana.Multiplier.Mage = 1.0
SoloSustain.Pet.Mana.Multiplier.Warlock = 1.0
SoloSustain.Pet.Mana.Multiplier.Druid = 1.0

########################################
# GUARDIAN HEALTH MULTIPLIER PER CLASS
# Scales the HEALTH heal amount that guardians receive.
# Guardians: Army of Dead, Mirror Images, Fire Elementals, etc.
# 1.0 = same as player, 0.5 = half, 2.0 = double
########################################

SoloSustain.Guardian.Health.Multiplier.Warrior = 1.0
SoloSustain.Guardian.Health.Multiplier.Paladin = 1.0
SoloSustain.Guardian.Health.Multiplier.Hunter = 1.0
SoloSustain.Guardian.Health.Multiplier.Rogue = 1.0
SoloSustain.Guardian.Health.Multiplier.Priest = 1.0
SoloSustain.Guardian.Health.Multiplier.DeathKnight = 1.0
SoloSustain.Guardian.Health.Multiplier.Shaman = 1.0
SoloSustain.Guardian.Health.Multiplier.Mage = 1.0
SoloSustain.Guardian.Health.Multiplier.Warlock = 1.0
SoloSustain.Guardian.Health.Multiplier.Druid = 1.0

########################################
# GUARDIAN MANA MULTIPLIER PER CLASS
# Scales the MANA restore amount that guardians receive.
# 1.0 = same as player, 0.5 = half, 2.0 = double
########################################

SoloSustain.Guardian.Mana.Multiplier.Warrior = 1.0
SoloSustain.Guardian.Mana.Multiplier.Paladin = 1.0
SoloSustain.Guardian.Mana.Multiplier.Hunter = 1.0
SoloSustain.Guardian.Mana.Multiplier.Rogue = 1.0
SoloSustain.Guardian.Mana.Multiplier.Priest = 1.0
SoloSustain.Guardian.Mana.Multiplier.DeathKnight = 1.0
SoloSustain.Guardian.Mana.Multiplier.Shaman = 1.0
SoloSustain.Guardian.Mana.Multiplier.Mage = 1.0
SoloSustain.Guardian.Mana.Multiplier.Warlock = 1.0
SoloSustain.Guardian.Mana.Multiplier.Druid = 1.0
