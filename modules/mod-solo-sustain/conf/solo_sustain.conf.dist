[worldserver]

########################################
# Solo Sustain Module Configuration
# Author: Ramvaris
# 
# Passive life and mana leech based on damage dealt.
# All values are percentages (0.10 = 10% of damage dealt).
#
# COMBAT LOG VISIBILITY (NO visual effects!):
# We do NOT cast spells - no animations, no sounds, no visual spam!
# Just the green/blue floating numbers and combat log entries.
# 
# How it works:
#   - HealBySpell() applies health + sends SMSG_SPELLHEALLOG packet
#   - EnergizeBySpell() applies mana + sends SMSG_SPELLENERGIZELOG packet  
#   - Client shows floating combat text from these packets
#   - Recount/MSBT/Details! parse these packets for their displays
#
# Spell IDs (for combat log TEXT only, not animations):
#   - 20267 "Life Steal" - Lifestealing enchant
#   - 20268 mana restore - Judgement of Wisdom
#
# Result: Clean green/blue numbers, no arcade game effect spam!
########################################

# Enable/Disable the module
SoloSustain.Enable = 1

# Debug mode - prints leech info to server console
SoloSustain.Debug = 0

########################################
# CUSTOM SPELL IDs
# Combat log name/icon comes from the spell's DBC entry.
# Use custom dummy spells for themed display names.
#
# Defaults:
#   Heal: 20267 "Life Steal" (Lifestealing enchant)
#   Mana: 20268 (Judgement of Wisdom energize)
#
# For custom spells, create a Spell.dbc entry with
# your desired name/icon and set the ID here.
########################################

SoloSustain.SpellId.Heal = 15286
SoloSustain.SpellId.Mana = 57669

########################################
# PET SUPPORT (Hunter/Warlock only)
# Permanent pets (IsPet() = true) get life leech.
# Does NOT support guardians/temporary summons.
# 
# Applies to:
#   - Hunter pets (all specs)
#   - Warlock pets (Imp, Voidwalker, Succubus, Felhunter, Felguard)
#
# NOTE: Pets heal THEMSELVES - owner's mana is unaffected.
########################################

# Enable leech for player pets
SoloSustain.Pet.Enable = 1

# Leech multiplier for pets (1.0 = same as owner's class value)
SoloSustain.Pet.LeechMultiplier = 1.0

########################################
# LIFE LEECH PER CLASS
# Percentage of damage dealt returned as HP.
# Melee classes need more sustain (face-tank damage).
# Ranged classes can kite/avoid damage.
# Default values are CONSERVATIVE - tune up for solo play!
########################################

# Pure melee - face-tank everything, need high sustain
SoloSustain.LifeLeech.Warrior = 0.08
SoloSustain.LifeLeech.Rogue = 0.08
SoloSustain.LifeLeech.DeathKnight = 0.05

# Ranged physical - can kite, moderate sustain
SoloSustain.LifeLeech.Hunter = 0.04

# Casters - can kite/control, low sustain
SoloSustain.LifeLeech.Mage = 0.03
SoloSustain.LifeLeech.Warlock = 0.02

# Healers - have actual healing, minimal sustain
SoloSustain.LifeLeech.Priest = 0.02
SoloSustain.LifeLeech.Shaman = 0.02
SoloSustain.LifeLeech.Druid = 0.02
SoloSustain.LifeLeech.Paladin = 0.02

########################################
# MANA LEECH PER CLASS
# Percentage of damage dealt returned as mana.
# Non-mana classes (Warrior/Rogue/DK) always 0.
########################################

SoloSustain.ManaLeech.Warrior = 0.00
SoloSustain.ManaLeech.Rogue = 0.00
SoloSustain.ManaLeech.DeathKnight = 0.00
SoloSustain.ManaLeech.Hunter = 0.08
SoloSustain.ManaLeech.Mage = 0.10
SoloSustain.ManaLeech.Warlock = 0.08
SoloSustain.ManaLeech.Priest = 0.08
SoloSustain.ManaLeech.Shaman = 0.08
SoloSustain.ManaLeech.Druid = 0.08
SoloSustain.ManaLeech.Paladin = 0.08

########################################
# CAPS
# Maximum heal/mana per tick as % of max HP/Mana.
# Prevents insane burst healing from big crits.
########################################

SoloSustain.LifeLeech.Cap = 0.15
SoloSustain.ManaLeech.Cap = 0.25
