[worldserver]

########################################
# Solo Sustain Module Configuration
# Author: Ramvaris
# 
# Passive life and mana leech based on damage dealt.
# All values are percentages (0.35 = 35% of damage dealt).
#
# VALUES CALCULATED FROM vampire.lua:
#   vampire.lua used: stat * multiplier per spell cast
#   This module uses: damage * percentage per damage tick
# 
# Conversion formula at level 80:
#   Life: (expectedStat * healMultiplier) / avgDamage
#   Mana: (expectedStat * manaMultiplier) / avgDamage
#
# COMBAT LOG VISIBILITY (NO visual effects!):
# We do NOT cast spells - no animations, no sounds, no visual spam!
# Just the green/blue floating numbers and combat log entries.
########################################

# Enable/Disable the module
SoloSustain.Enable = 1

# Debug mode - prints leech info to server console
SoloSustain.Debug = 0

########################################
# CUSTOM SPELL IDs
# Combat log name/icon comes from the spell's DBC entry.
# Default: Custom dummy spells (81009/81012)
# Requires custom Spell.dbc entries for proper names.
########################################

SoloSustain.SpellId.Heal = 81009
SoloSustain.SpellId.Mana = 81012

########################################
# PET SUPPORT (Hunter/Warlock only)
# Permanent pets (IsPet() = true) get life leech.
# Does NOT support guardians/temporary summons.
# 
# Applies to:
#   - Hunter pets (all specs)
#   - Warlock pets (Imp, Voidwalker, Succubus, Felhunter, Felguard)
#
# NOTE: Pets heal THEMSELVES - owner's mana is unaffected.
########################################

# Enable leech for player pets
SoloSustain.Pet.Enable = 1

# Leech multiplier for pets (1.0 = same as owner's class value)
SoloSustain.Pet.LeechMultiplier = 1.0

########################################
# LIFE LEECH PER CLASS
# From vampire.lua: stat * healMultiplier per spell cast
# Converted to: damage * percentage
#
# vampire.lua original values:
#   ROGUE:   AP * 0.33 → 4500 * 0.33 / 4000 = 0.37
#   WARRIOR: AP * 0.33 → 4500 * 0.33 / 4000 = 0.37
#   HUNTER:  RAP * 0.14 → 4000 * 0.14 / 3500 = 0.16
#   MAGE:    SP * 0.25 → 2800 * 0.25 / 4500 = 0.16
#   Others:  0 (mana-only mode)
#   DK:      Not in vampire, ~0.30 (has Death Strike)
########################################

# Pure melee - face-tank everything, high sustain
SoloSustain.LifeLeech.Warrior = 0.35
SoloSustain.LifeLeech.Rogue = 0.35
SoloSustain.LifeLeech.DeathKnight = 0.30

# Ranged physical + Mage (moderate sustain)
SoloSustain.LifeLeech.Hunter = 0.16
SoloSustain.LifeLeech.Mage = 0.16

# No life leech (mode = "MANA" in vampire.lua)
SoloSustain.LifeLeech.Warlock = 0.00
SoloSustain.LifeLeech.Priest = 0.00
SoloSustain.LifeLeech.Shaman = 0.00
SoloSustain.LifeLeech.Druid = 0.00
SoloSustain.LifeLeech.Paladin = 0.00

########################################
# MANA LEECH PER CLASS
# From vampire.lua: stat * manaMultiplier per spell cast
# Converted to: damage * percentage
#
# vampire.lua original values:
#   HUNTER:  RAP * 0.50 → 4000 * 0.50 / 3500 = 0.57
#   MAGE:    SP * 1.00 → 2800 * 1.00 / 4500 = 0.62
#   WARLOCK: SP * 1.00 → 2800 * 1.00 / 4500 = 0.62
#   Healers: SP * 1.00 → 2800 * 1.00 / 3000 = 0.93
#   Druid:   SP * 1.00 → 2800 * 1.00 / 3500 = 0.80
########################################

SoloSustain.ManaLeech.Warrior = 0.00
SoloSustain.ManaLeech.Rogue = 0.00
SoloSustain.ManaLeech.DeathKnight = 0.00
SoloSustain.ManaLeech.Hunter = 0.55
SoloSustain.ManaLeech.Mage = 0.60
SoloSustain.ManaLeech.Warlock = 0.60
SoloSustain.ManaLeech.Priest = 0.90
SoloSustain.ManaLeech.Shaman = 0.90
SoloSustain.ManaLeech.Druid = 0.80
SoloSustain.ManaLeech.Paladin = 0.90
