###################################################################################################
# Ramvaris Custom MOD
# CUSTOM MODULE — PRIVATE SERVER ONLY
# This configuration does nothing on standard AzerothCore servers.
# Safe to ignore for cloners. All sub-features OFF by default.
###################################################################################################

[worldserver]

###################################################################################################
# GLOBAL TOGGLE
#
# CustomRamvaris.Enable
#     Master switch for the entire mod-custom-ramvaris module.
#     If disabled, ALL features below are inactive regardless of their individual toggles.
#     Default: 1 (ON — module loads, but all sub-features are OFF by default)
#
###################################################################################################

CustomRamvaris.Enable = 1

###################################################################################################
#                                                                                                 #
#  SECTION 1: FEATURES THAT WORK WITHOUT CUSTOM DBC / MPQ FILES                                  #
#  These can be used by ANYONE on a stock AzerothCore client (3.3.5a).                            #
#  No custom spells, creatures, or client data needed.                                            #
#                                                                                                 #
###################################################################################################

#
# CustomRamvaris.LotteryEnchants.Enable
#     Diablo-style lottery enchantments on ALL acquired weapons/armor (any quality,
#     grey through legendary). Vendor purchases silently excluded via
#     PLAYERHOOK_ON_BEFORE_BUY_ITEM_FROM_VENDOR — prevents mass-buying cheap items.
#     Vendor buyback uses Player::StoreItem (not StoreNewItem), also safe.
#     Scans SpellItemEnchantment DBC at startup for pure stat + resistance enchants.
#     NO class filtering — any stat/resist rolls on any class. Self-balancing:
#     a warrior rolling INT+SPI+FIRE_RES is a crap roll. Dilution IS the balance.
#     Pool includes primary stats, combat ratings, spell power, all secondaries,
#     AND all elemental resistances (Holy/Fire/Nature/Frost/Shadow/Arcane).
#     Pool EXCLUDES: Dodge, Parry, Defense (overcapping with multiple items).
#     Up to 7 enchants per item via cascading 70/60/50/50/50/40/40% chances.
#     Stats stored in custom DB table — completely decoupled from item slots.
#     Level-scaled: stats grow linearly from 1.25% (level 1) to 100% (level 80).
#     Stats update automatically on level-up (delta-based recalculation).
#     SPEED: Regular dice pool entry. +1-25% per roll, stacks to +100% (200% base),
#            affects run+swim+flight, multiplicative with auras. Core patch in UpdateSpeed.
#     FLY: 1% leftover chance. Sub-roll 75/20/5% for Stage 1/2/3 (100/200/300%).
#          Effective speed = flyStageRate × (1 + speedBonus), max 600% (superman mode).
#          Flying everywhere, BG flag drops if airborne.
#          .flylock command to voluntarily disable flight.
#     Commands: .enchants (paginated gossip viewer), .reroll (gossip-based reroll
#              with Take/Keep flow, gold on roll), .flylock (toggle flight lock).
#     7 color tiers (~14.29% each): grey→white→green→blue→purple→orange→RED.
#     Item name color = enchant COUNT (1=grey..7=red), stat color = VALUE percentile.
#     Items with lottery enchants get 777/777 durability as visual marker.
#     Default: 0 (OFF)
#

CustomRamvaris.LotteryEnchants.Enable = 0

#
# CustomRamvaris.LotteryEnchants.MaxSlots
#     Maximum number of lottery enchant slots per item (1-7).
#     Each slot has decreasing roll chance (70% → 60% → 50% → 50% → 50% → 40% → 40%).
#     Item name color in `.enchants` reflects count: 1=grey, 2=white, 3=green,
#     4=blue, 5=purple, 6=orange, 7=red. Stat value color = percentile of global max.
#     Items with lottery enchants get 777/777 durability as visual marker.
#     Default: 7
#

CustomRamvaris.LotteryEnchants.MaxSlots = 7

#
# CustomRamvaris.SmartWanderingBots.Enable
#     Zone-aware dynamic bot spawning — the performance-friendly alternative to
#     global wandering bots. Spawns MinAmount–MaxAmount bots ONLY in the player's
#     current zone and despawns them on zone change.
#     REQUIRES NpcBot.WanderingBots.Continents.Count = 0 in npcbots.conf!
#     Without this, the normal global system runs alongside smart bots.
#     Core patch: extends BotDataMgr with zone-specific spawn/despawn API.
#     [NO DB] — uses existing WanderNode system, no custom data needed!
#     Default: 0 (OFF)
#

CustomRamvaris.SmartWanderingBots.Enable = 0

#
# CustomRamvaris.SmartWanderingBots.MinAmount
#     Minimum number of bots to spawn when entering a new zone.
#     Actual count is randomized between MinAmount and MaxAmount.
#     Some zones may have fewer WanderNodes than requested — spawns what fits.
#     Default: 5
#

CustomRamvaris.SmartWanderingBots.MinAmount = 0

#
# CustomRamvaris.SmartWanderingBots.MaxAmount
#     Maximum number of bots to spawn when entering a new zone.
#     Keep this low for single-player servers — performance is king.
#     Default: 15
#

CustomRamvaris.SmartWanderingBots.MaxAmount = 2

#
# CustomRamvaris.SmartWanderingBots.ZoneChangeCooldown
#     Cooldown in seconds between zone-change spawns.
#     Prevents rapid spawn/despawn flapping when riding along zone borders.
#     Set higher (60+) for extra stability, lower (10) for faster response.
#     Default: 30
#

CustomRamvaris.SmartWanderingBots.ZoneChangeCooldown = 30

#
# CustomRamvaris.SmartWanderingBots.BalancedFaction.Enable
#     When ON, smart wandering bots try to maintain an even Alliance/Horde ratio.
#     If the random spawn pool is 3 Alliance and 1 Horde, the system adds extra
#     Horde bots to match. Neutral/hostile bots don't count toward the ratio.
#     [NO DB] — works with vanilla client
#     Default: 0 (OFF)
#

CustomRamvaris.SmartWanderingBots.BalancedFaction.Enable = 1

#
# CustomRamvaris.DarkAzeroth.Enable
#     Dark Azeroth — biome-aware bad weather across all zones.
#     Hot zones get thunderstorms, cold zones get snow, others get rain.
#     5% sunny, 25% light, 30% medium, 40% heavy weather.
#     Triggers on login and zone change.
#     [NO DB] — works with vanilla client, no custom data needed!
#     Hint: If WEATHER in Stormwind and other cities is wanted, you need to
#     update the WEATHER entry for those zones in the SQL database.
#     Default: 0 (OFF)
#

CustomRamvaris.DarkAzeroth.Enable = 0

#
# CustomRamvaris.GuardianScale.Enable
#     .guardianscale command — doubles Soul Keeper guardian visual scale (caps at 5x).
#     Only affects Soul Keeper guardians (IsSoulKeeperGuardian check).
#     [NO DB] — works with vanilla client
#     Default: 0 (OFF)
#

CustomRamvaris.GuardianScale.Enable = 0

#
# CustomRamvaris.PetScale.Enable
#     .petscale command — doubles any pet visual scale (Hunter/Warlock/DK).
#     Only affects proper pets (IsPet check), not guardians or totems.
#     [NO DB] — works with vanilla client
#     Default: 0 (OFF)
#

CustomRamvaris.PetScale.Enable = 0

#
# CustomRamvaris.PetStayOnMount.Enable
#     Keeps pets summoned when the player mounts up instead of dismissing them.
#     Pets will run alongside the mounted player. Only affects mounting — other
#     dismiss triggers (vehicle, teleport, logout) are unchanged.
#     Core patch to Unit::Mount() — reverts to vanilla behavior when OFF.
#     [NO DB] — works with vanilla client
#     Default: 0 (OFF)
#

CustomRamvaris.PetStayOnMount.Enable = 0

###################################################################################################
#                                                                                                 #
#  SECTION 2: FEATURES REQUIRING CUSTOM DBC / MPQ / CREATURE DATA                                #
#  These need custom spells, creature_template entries, or client-side data.                      #
#  Won't do anything useful without the matching server/client data in place.                     #
#                                                                                                 #
###################################################################################################

#
# CustomRamvaris.HumanStoneform.Enable
#     Human Stoneform racial (Spell ID 81013) — cleanses Poison, Disease, Curse, Magic.
#     Requires custom DBC entry for spell 81013 (SPELL_EFFECT_DUMMY, 2min CD).
#     [CUSTOM DB] — needs spell 81013 in DBC
#     Default: 0 (OFF)
#

CustomRamvaris.HumanStoneform.Enable = 0

#
# CustomRamvaris.NpcFlavorText.Enable
#     NPC summon flavor text — random witty sayings when custom NPCs are summoned.
#     Affects: Ling (290011), Ashari (299902), Squeak (299901), Cromi (300000),
#              Ciel (299903), Rename (200002), Warpweaver (190011).
#     Lilly (299900) flavor text is controlled by LillyGossip toggle below.
#     [CUSTOM DB] — needs custom creature_template entries + ScriptNames
#     Default: 0 (OFF)
#

CustomRamvaris.NpcFlavorText.Enable = 0

#
# CustomRamvaris.LillyGossip.Enable
#     Lilly helper NPC (299900) — teleportation, instance reset, talent point purchase.
#     Also includes Lilly's summon flavor text.
#     [CUSTOM DB] — needs custom creature_template entry 299900 + ScriptName
#     Default: 0 (OFF)
#

CustomRamvaris.LillyGossip.Enable = 0

#
# CustomRamvaris.LoginSpellGrants.Enable
#     Auto-learn utility spells and profession specializations on login.
#     Grants: custom spells (81005, 81007, 81013),
#             Diplomacy for all, Pick Pocket for all, Draenei racial fixes,
#             BE Warrior Arcane Torrent, profession dual/triple spec unlock.
#     UNLEARNS on login: 81002 (Water Form), 81003 (Uber Cheetah), 81008 (Levitation)
#     — replaced by lottery enchant speed/fly system.
#     [CUSTOM DB] — needs custom DBC spell entries
#     Default: 0 (OFF)
#

CustomRamvaris.LoginSpellGrants.Enable = 0

#
# CustomRamvaris.SpecialCommand.Enable
#     .special command — gossip menu to summon custom NPCs, open bank, open mailbox.
#     NPCs spawn as temporary summons for 60 seconds.
#     [CUSTOM DB] — NPC summons need custom creature_template entries
#     Default: 0 (OFF)
#

CustomRamvaris.SpecialCommand.Enable = 0
